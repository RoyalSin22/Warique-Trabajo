# backend/.env.example  -> copy to .env and fill real values (never commit .env)
# The file location can be overridden with WARIQUE_ENV_FILE (the Windows service uses C:\Warique\config\.env)
PORT=3000
DATABASE_URL="mysql://warique_app:CHANGE_ME@localhost:3306/warique_orders"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME
# 43200 s = 12 h (one work shift)
JWT_EXPIRES_IN_SECONDS=43200

# Business time zone offset in minutes (Peru = UTC-5, no daylight saving)
BUSINESS_UTC_OFFSET_MINUTES=-300

# Only for development, when the Flutter web client runs on another origin (flutter run).
# In production the backend serves the web build itself (same origin), so leave it empty.
CORS_ORIGINS=http://localhost:8080

# Used only by `npm run db:seed` to create the first OWNER account
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=CHANGE_ME
SEED_OWNER_FULL_NAME=Owner

# Optional: folder with the Flutter web build (index.html). Defaults to ./public when present.
# WEB_DIR=C:\Warique\app\public

# Optional: status file written by deploy/windows/backup.ps1, shown to the owner in the app
# BACKUP_STATUS_FILE=C:\Warique\logs\ultimo-respaldo.json
