# backend/.env.example  -> copy to .env and fill real values (never commit .env)
PORT=3000
DATABASE_URL="mysql://warique_app:CHANGE_ME@localhost:3306/warique_orders"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME
# 43200 s = 12 h (one work shift)
JWT_EXPIRES_IN_SECONDS=43200

# Business time zone offset in minutes (Peru = UTC-5, no daylight saving)
BUSINESS_UTC_OFFSET_MINUTES=-300

# Comma-separated origins allowed for the Flutter web client
CORS_ORIGINS=http://localhost:8080

# Used only by `npm run db:seed` to create the first OWNER account
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=CHANGE_ME
SEED_OWNER_FULL_NAME=Owner
