// backend/prisma/schema.prisma
// Source of truth is database/schema.sql + database/migrations/*.sql (CHECK constraints + generated columns).
// Use Prisma ONLY as a client: `npx prisma generate`. Do NOT run `prisma migrate`.

generator client {
  provider      = "prisma-client-js"
  // "windows": the release package can be built on Linux/macOS and still run on the restaurant PC
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  WAITER
  KITCHEN
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  YAPE
  PLIN
}

enum SupplyUnit {
  KG
  L
  UNIDAD
  ATADO
  PAQUETE
}

enum MovementType {
  PURCHASE
  COUNT
  WASTE
  USE
  VOID
}

enum ExpenseCategory {
  INSUMOS
  GAS
  SERVICIOS
  SUELDOS
  ALQUILER
  TRANSPORTE
  OTROS
}

enum PaidWith {
  CASH
  OTHER
}

model User {
  id           Int              @id @default(autoincrement()) @db.UnsignedInt
  fullName     String           @map("full_name") @db.VarChar(100)
  username     String           @unique @db.VarChar(50)
  passwordHash String           @map("password_hash") @db.VarChar(255)
  role         Role
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  orders       Order[]
  payments     Payment[]
  expenses     Expense[]
  movements    SupplyMovement[]
  cashOpened   CashSession[]    @relation("cashOpenedBy")
  cashClosed   CashSession[]    @relation("cashClosedBy")

  @@map("users")
}

model Category {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  name      String  @unique @db.VarChar(60)
  sortOrder Int     @default(0) @map("sort_order") @db.UnsignedSmallInt
  isActive  Boolean @default(true) @map("is_active")
  dishes    Dish[]

  @@map("categories")
}

model Dish {
  id          Int         @id @default(autoincrement()) @db.UnsignedInt
  categoryId  Int         @map("category_id") @db.UnsignedInt
  name        String      @db.VarChar(100)
  description String?     @db.VarChar(255)
  price       Decimal     @db.Decimal(10, 2)
  isAvailable Boolean     @default(true) @map("is_available")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@unique([categoryId, name])
  @@map("dishes")
}

model DiningTable {
  id       Int     @id @default(autoincrement()) @db.UnsignedInt
  label    String  @unique @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")
  orders   Order[]

  @@map("dining_tables")
}

model Order {
  id            Int           @id @default(autoincrement()) @db.UnsignedInt
  orderType     OrderType     @map("order_type")
  tableId       Int?          @map("table_id") @db.UnsignedInt
  customerName  String?       @map("customer_name") @db.VarChar(80)
  waiterId      Int           @map("waiter_id") @db.UnsignedInt
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  total         Decimal       @default(0) @db.Decimal(10, 2)
  notes         String?       @db.VarChar(255)
  cancelReason  String?       @map("cancel_reason") @db.VarChar(255)
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  paidAt        DateTime?     @map("paid_at") @db.DateTime(0)
  table         DiningTable?  @relation(fields: [tableId], references: [id])
  waiter        User          @relation(fields: [waiterId], references: [id])
  items         OrderItem[]
  payments      Payment[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  orderId   Int      @map("order_id") @db.UnsignedInt
  dishId    Int      @map("dish_id") @db.UnsignedInt
  dishName  String   @map("dish_name") @db.VarChar(100)
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity  Int      @db.UnsignedSmallInt
  /// Generated column in MySQL: read-only, never set it on create/update.
  subtotal  Decimal? @db.Decimal(12, 2)
  notes     String?  @db.VarChar(150)
  order     Order    @relation(fields: [orderId], references: [id])
  dish      Dish     @relation(fields: [dishId], references: [id])

  @@map("order_items")
}

model Payment {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  orderId         Int           @map("order_id") @db.UnsignedInt
  method          PaymentMethod
  amount          Decimal       @db.Decimal(10, 2)
  amountReceived  Decimal?      @map("amount_received") @db.Decimal(10, 2)
  /// Generated column in MySQL: read-only, never set it on create/update.
  changeGiven     Decimal?      @map("change_given") @db.Decimal(10, 2)
  operationNumber String?       @map("operation_number") @db.VarChar(30)
  registeredBy    Int           @map("registered_by") @db.UnsignedInt
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  order           Order         @relation(fields: [orderId], references: [id])
  registeredUser  User          @relation(fields: [registeredBy], references: [id])

  @@index([createdAt])
  @@map("payments")
}

model Supply {
  id        Int              @id @default(autoincrement()) @db.UnsignedInt
  name      String           @unique @db.VarChar(60)
  unit      SupplyUnit
  /// Only changed by SuppliesService/ExpensesService together with a SupplyMovement row.
  stock     Decimal          @default(0) @db.Decimal(12, 3)
  minStock  Decimal          @default(0) @map("min_stock") @db.Decimal(12, 3)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  movements SupplyMovement[]
  items     ExpenseItem[]

  @@map("supplies")
}

model Expense {
  id           Int              @id @default(autoincrement()) @db.UnsignedInt
  businessDate DateTime         @map("business_date") @db.Date
  category     ExpenseCategory
  description  String           @db.VarChar(150)
  amount       Decimal          @db.Decimal(10, 2)
  paidWith     PaidWith         @map("paid_with")
  isVoid       Boolean          @default(false) @map("is_void")
  voidReason   String?          @map("void_reason") @db.VarChar(150)
  createdBy    Int              @map("created_by") @db.UnsignedInt
  createdAt    DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  creator      User             @relation(fields: [createdBy], references: [id])
  items        ExpenseItem[]
  movements    SupplyMovement[]

  @@index([businessDate])
  @@map("expenses")
}

model ExpenseItem {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  expenseId Int     @map("expense_id") @db.UnsignedInt
  supplyId  Int     @map("supply_id") @db.UnsignedInt
  quantity  Decimal @db.Decimal(12, 3)
  cost      Decimal @db.Decimal(10, 2)
  expense   Expense @relation(fields: [expenseId], references: [id])
  supply    Supply  @relation(fields: [supplyId], references: [id])

  @@map("expense_items")
}

model SupplyMovement {
  id         Int          @id @default(autoincrement()) @db.UnsignedInt
  supplyId   Int          @map("supply_id") @db.UnsignedInt
  type       MovementType
  /// Signed change: + in, - out
  quantity   Decimal      @db.Decimal(12, 3)
  stockAfter Decimal      @map("stock_after") @db.Decimal(12, 3)
  expenseId  Int?         @map("expense_id") @db.UnsignedInt
  note       String?      @db.VarChar(150)
  createdBy  Int          @map("created_by") @db.UnsignedInt
  createdAt  DateTime     @default(now()) @map("created_at") @db.DateTime(0)
  supply     Supply       @relation(fields: [supplyId], references: [id])
  expense    Expense?     @relation(fields: [expenseId], references: [id])
  creator    User         @relation(fields: [createdBy], references: [id])

  @@index([supplyId, createdAt])
  @@map("supply_movements")
}

model CashSession {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  businessDate   DateTime  @unique @map("business_date") @db.Date
  openingAmount  Decimal   @map("opening_amount") @db.Decimal(10, 2)
  openedBy       Int       @map("opened_by") @db.UnsignedInt
  openedAt       DateTime  @default(now()) @map("opened_at") @db.DateTime(0)
  expectedAmount Decimal?  @map("expected_amount") @db.Decimal(10, 2)
  countedAmount  Decimal?  @map("counted_amount") @db.Decimal(10, 2)
  difference     Decimal?  @db.Decimal(10, 2)
  notes          String?   @db.VarChar(255)
  closedBy       Int?      @map("closed_by") @db.UnsignedInt
  closedAt       DateTime? @map("closed_at") @db.DateTime(0)
  opener         User      @relation("cashOpenedBy", fields: [openedBy], references: [id])
  closer         User?     @relation("cashClosedBy", fields: [closedBy], references: [id])

  @@map("cash_sessions")
}
